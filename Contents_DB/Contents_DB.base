formulas:
  progress_pct: if(total_length > 0, (progress / total_length * 100).toFixed(1) + "%", "")
properties:
  formula.progress_pct:
    displayName: Progress (%)
views:
  - type: table
    name: All
    filters:
      and:
        - file.inFolder("Contents_DB")
    order:
      - file.name
      - category
      - genre
      - rating
      - status
      - watched_date
      - formula.progress_pct
      - progress
      - total_length
      - season_volume
      - creator
      - cast
      - release_day
      - emotions
    sort:
      - property: file.name
        direction: ASC
      - property: genre
        direction: ASC
      - property: release_day
        direction: ASC
      - property: season_volume
        direction: DESC
      - property: watched_date
        direction: DESC
      - property: rating
        direction: DESC
    columnSize:
      note.genre: 371
  - type: table
    name: Auto
