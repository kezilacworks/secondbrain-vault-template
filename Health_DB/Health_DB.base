views:
  - type: table
    name: 데일리 전체
    filters:
      and:
        - file.inFolder("Health_DB/Health_데일리")
    order:
      - file.name
      - date
      - condition
      - weight
      - sleep_hours
      - water
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 인바디 추적
    filters:
      and:
        - file.inFolder("Health_DB/Health_데일리")
        - weight is_not_empty
    order:
      - file.name
      - date
      - weight
      - muscle_mass
      - body_fat_pct
      - BMI
      - inbody_score
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 건강지식
    filters:
      and:
        - file.inFolder("Health_DB/Health_지식")
    order:
      - file.name
      - topic
      - status
      - updated
    sort:
      - property: updated
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: 깨달음/게시
    filters:
      and:
        - file.inFolder("Health_DB/Health_깨달음")
    order:
      - file.name
      - topic
      - status
      - publish_platform
      - published_date
    sort:
      - property: published_date
        direction: DESC
      - property: status
        direction: ASC
