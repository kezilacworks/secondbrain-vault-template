views:
  - type: table
    name: All
    filters:
      and:
        - file.inFolder("People_DB")
    order:
      - file.name
      - relation
      - relation_type
      - affiliation
      - position
      - closeness
      - first_met
      - last_contact
      - status
    sort:
      - property: relation
        direction: ASC
      - property: closeness
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: Work
    filters:
      and:
        - file.inFolder("People_DB")
        - relation == "work"
    order:
      - file.name
      - relation_type
      - affiliation
      - position
      - last_contact
      - status
    sort:
      - property: last_contact
        direction: DESC
