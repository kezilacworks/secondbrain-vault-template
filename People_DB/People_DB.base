views:
  - type: table
    name: 전체
    filters:
      and:
        - file.inFolder("People_DB")
    order:
      - file.name
      - relation
      - relation_type
      - 소속
      - 직책
      - 친밀도
      - 첫_만남
      - 최근_접촉
      - status
    sort:
      - property: relation
        direction: ASC
      - property: 친밀도
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: 업무
    filters:
      and:
        - file.inFolder("People_DB")
        - relation == "work"
    order:
      - file.name
      - relation_type
      - 소속
      - 직책
      - 최근_접촉
      - status
    sort:
      - property: 최근_접촉
        direction: DESC
